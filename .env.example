# Copy to .env and fill in. Never commit .env.

# --- database / cache (docker compose overrides these for the api + worker containers) ---
DATABASE_URL=sqlite:///./agripulse.db
REDIS_URL=
POSTGRES_PASSWORD=agripulse

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=14
ADMIN_EMAIL=admin@agripulse.local
# Required on Postgres (the API refuses to seed an admin without it)
ADMIN_PASSWORD=
DEMO_PASSWORD=agripulse-demo

# --- data sources ---
# Free key from https://data.gov.in (My Account -> Generate API key)
DATA_GOV_API_KEY=
AGMARKNET_STATES=Karnataka,Tamil Nadu,Andhra Pradesh,Telangana,Maharashtra,Kerala

# --- routing ---
# Empty = straight-line x 1.3 fallback (clearly flagged). After infra/osrm/prepare.sh: http://osrm:5000
OSRM_URL=

# --- mandi graph mirror (V2-3, optional; only used when config/graph.toml [graph] backend = "neo4j") ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- alerts (all optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@agripulse.local
SMS_WEBHOOK_URL=

# --- web ---
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Empty = browser uses <same host>:8000 (dev / LAN). Prod overlay sets https://$DOMAIN/api.
NEXT_PUBLIC_API_URL=

# Run ingestion jobs inside the API process (dev only; compose uses the worker service)
ENABLE_SCHEDULER=false
